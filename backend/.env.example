# Скопируйте в .env и при необходимости поправьте.
# Учебный проект: ниже — осознанно простые значения (не для боевого магазина).

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_store_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (production на Railway: задайте те же или свои, не оставляйте пустым)
SECRET_KEY=gna-tg-store-edu-secret-key-32chars-min-ok!
ADMIN_PASSWORD=gna-edu-demo-2026

# Telegram
TELEGRAM_BOT_TOKEN=

# Environment
ENVIRONMENT=development

# Payment / optional — свои ключи или пусто
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
SENTRY_DSN=
